# Copy to backend/.env and fill in.
# The agent uses the OpenAI SDK, so any OpenAI-COMPATIBLE provider works — set the key,
# base URL, and model together.

# --- Option A: OpenAI ---
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o

# --- Option B: Google Gemini (free tier, no credit card) ---
# Get a key at https://aistudio.google.com/apikey
OPENAI_API_KEY=AIza...
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-3.5-flash-lite

# --- Option C: Groq (free, no credit card) ---
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

MAX_TOKENS=2048
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
